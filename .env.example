# ProcessPilot environment variables.
#
# Copy this file's variable NAMES into real values in:
#   - GitHub Codespaces secrets (development)         -> repo/org Settings > Secrets and variables > Codespaces
#   - GitHub Actions secrets/environments (CI)         -> repo Settings > Secrets and variables > Actions
#   - Vercel project settings (preview/production)     -> Vercel dashboard > Project > Settings > Environment Variables
#   - The relevant provider dashboard for provider-managed credentials
#
# Never put real values in this file, in source, in git history, in PR
# descriptions, in screenshots, or in logs. This file exists so every
# variable name is documented in one place with a safe placeholder.
#
# A trailing "# required" marks a variable that `npm run env:check` enforces
# must be set. Variables without that marker are documented for upcoming
# phases (auth, database, billing, etc.) and are not enforced yet — they will
# be promoted to required as each integration is implemented.

# --- Application ---------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Gates the internal /design-system component gallery route (404s when
# unset/false). Enable in Preview so it's reachable for phase review; leave
# unset in Production.
NEXT_PUBLIC_ENABLE_DESIGN_SYSTEM=false

# --- Database (Supabase PostgreSQL — see docs/development/supabase-setup.md) ---
# Exposed to the browser. Not yet consumed by any code — no browser
# Supabase client exists as of Phase 4 (see
# docs/architecture/clerk-supabase-identity-sync.md); documented now so
# the name is reserved for when one is genuinely needed.
NEXT_PUBLIC_SUPABASE_URL=https://replace-me.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Reserved for future Supabase JS client use (e.g. Storage in Phase 6).
# Server-only Postgres access in Phase 4 uses SUPABASE_DB_URL's superuser
# connection with explicit role-switching instead — see
# src/lib/db/client-admin.ts. Never expose this to client code.
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Direct Postgres connection string (session pooler recommended). Server-only.
SUPABASE_DB_URL=postgresql://postgres:replace-me@db.replace-me.supabase.co:5432/postgres # required

# --- Authentication (Clerk) -----------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me # required
CLERK_SECRET_KEY=sk_test_replace_me # required
# Signing secret for the /api/webhooks/clerk endpoint (Clerk dashboard ->
# Webhooks -> your endpoint -> Signing Secret).
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me # required
# Email of a pre-existing user in the same Clerk instance as the keys above,
# used only by e2e/app-auth.spec.ts's signed-in-user Playwright test
# (GitHub Actions preview-checks.yml) via clerk.signIn's server-side ticket
# flow — no password needed. Not consumed by application code.
E2E_CLERK_USER_EMAIL=e2e-test-user@example.com

# --- Storage (planned — e.g. S3-compatible object storage) ---------------
STORAGE_BUCKET_NAME=processpilot-dev
STORAGE_ACCESS_KEY_ID=replace-me
STORAGE_SECRET_ACCESS_KEY=replace-me

# --- Billing (Phase 17 — Stripe) -------------------------------------------
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Stripe price ids for each product/pricing-hypotheses.md working tier —
# unset until a real Stripe product/price catalog exists (no committed
# pricing yet, see src/lib/billing/plans.ts). Optional: a plan with no
# configured price id simply can't be checked out into yet.
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_BUSINESS=
STRIPE_PRICE_ID_ENTERPRISE=

# --- Background jobs (Phase 8 — Postgres-backed queue, see src/lib/jobs/) ---
# No separate queue connection: the job queue is a table reached through
# SUPABASE_DB_URL's admin connection (src/lib/db/client-admin.ts). This
# secret authenticates the Vercel Cron-triggered worker endpoint
# (src/app/api/jobs/process/route.ts) — Vercel sends it automatically as
# an `Authorization: Bearer` header when a cron job fires.
CRON_SECRET=replace-me-with-a-long-random-value # required

# --- Email (Phase 16 — Resend) ----------------------------------------------
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_PROVIDER_API_KEY=replace-me

# --- AI (Phase 13 — Anthropic API) -----------------------------------------
ANTHROPIC_API_KEY=sk-ant-replace-me

# --- Deployment (Vercel-provided at build/runtime, no action needed) -----
# VERCEL=1
# VERCEL_ENV=development
# VERCEL_URL=
