{
  "name": "processpilot",
  "version": "0.1.0",
  "private": true,
  "description": "ProcessPilot — the operating system for repeatable business work.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "env:check": "node scripts/check-env.mjs",
    "git:status": "node scripts/git-status.mjs",
    "phase:commit": "bash scripts/prepare-phase-commit.sh"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5",
    "vitest": "^2.1.8"
  }
}
