{
  "name": "processpilot",
  "version": "0.1.0",
  "private": true,
  "description": "ProcessPilot — the operating system for repeatable business work.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "env:check": "node scripts/check-env.mjs",
    "git:status": "node scripts/git-status.mjs",
    "phase:commit": "bash scripts/prepare-phase-commit.sh",
    "db:link": "supabase link",
    "db:migrate": "supabase db push",
    "db:types": "supabase gen types typescript --linked > src/lib/db/database.types.ts",
    "db:seed": "node scripts/seed-dev-data.mjs",
    "check:bundle-secrets": "node scripts/check-no-service-role-in-client-bundle.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@clerk/nextjs": "^7.5.20",
    "@supabase/supabase-js": "^2.110.8",
    "@xyflow/react": "^12.11.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "mammoth": "^1.12.0",
    "next": "16.2.11",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "stripe": "^22.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.10",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "supabase": "^2.109.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "sharp": "^0.35.0",
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.5"
  }
}
